@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-orange-50">
    <div class="w-20 bg-gradient-to-b from-orange-500 to-orange-600 h-screen fixed left-0 top-0 flex flex-col items-center py-6 shadow-xl z-50">
        <div class="mb-8">
            <h2 class="text-white text-2xl font-bold">K</h2>
        </div>

        <button onclick="focusProductSearch()"
                class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-orange-500 hover:scale-110 transition-transform mb-6 shadow-lg"
                title="Add inventory">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
        </button>

        <a href="@Url.Action("Dashboard", "Home")" class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20" title="Dashboard">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
        </a>

        <a href="@Url.Action("SalesTracker", "Home")" class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20" title="Sales">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
        </a>

        <a href="@Url.Action("Inventory", "Home")" class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 bg-white text-orange-500" title="Inventory">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
        </a>

        <a href="@Url.Action("UtangLogs", "Home")" class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20" title="Utang">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
        </a>

        <a href="@Url.Action("Expenses", "Home")" class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20" title="Expenses">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"></path>
            </svg>
        </a>

        <div class="mt-auto">
            <a href="@Url.Action("Profile", "Home")" class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-white hover:bg-white/30 transition-all" title="Profile">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
            </a>
        </div>
    </div>

    <div class="ml-20 p-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8">
            <div>
                <h1 class="text-4xl font-bold text-gray-800">Inventory</h1>
                <p class="text-gray-500 mt-2">Use your Product Master List to add stock without retyping product details.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
            <section class="xl:col-span-1 bg-white rounded-xl p-6 shadow-md">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Add Inventory</h2>

                <div class="space-y-4">
                    <div class="relative">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Search Product</label>
                        <input type="text" id="inventoryProductSearch" autocomplete="off" placeholder="Type product name or barcode"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
                        <div id="productSuggestions" class="hidden absolute left-0 right-0 top-full mt-2 bg-white border border-gray-200 rounded-lg shadow-xl z-40 overflow-hidden"></div>
                    </div>

                    <div id="productNotFound" class="hidden bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg p-4">
                        <p class="font-semibold">Product not found</p>
                        <button onclick="openProductModalFromSearch()" class="text-orange-600 font-semibold mt-2 hover:text-orange-700">Add this product</button>
                    </div>

                    <div id="selectedProductCard" class="hidden border border-orange-200 bg-orange-50 rounded-lg p-4"></div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Quantity / Stock</label>
                        <input type="number" id="inventoryQuantity" min="1" step="1" placeholder="0"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Cost / Buying Price</label>
                        <input type="number" id="inventoryCostPrice" min="0" step="0.01" placeholder="0.00"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Selling Price</label>
                        <input type="number" id="inventoryPrice" min="0" step="0.01" placeholder="0.00"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Expiration Date</label>
                        <input type="date" id="inventoryExpiration"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
                    </div>

                    <button onclick="addInventoryItem()"
                            class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors">
                        Save Inventory
                    </button>
                </div>
            </section>

            <section class="xl:col-span-2 bg-white rounded-xl p-6 shadow-md">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
                    <h2 class="text-xl font-bold text-gray-800">Current Inventory</h2>
                    <input type="text" id="inventoryFilter" placeholder="Filter inventory"
                           class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
                </div>
                <div id="inventoryTable" class="overflow-x-auto"></div>
            </section>
        </div>

        <section class="bg-white rounded-xl p-6 shadow-md">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
                <h2 class="text-xl font-bold text-gray-800">Product Master List</h2>
                <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
                    <input type="text" id="libraryFilter" placeholder="Search products"
                           class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
                    <button onclick="openProductModal()"
                            class="bg-orange-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-orange-600 transition-colors">
                        Add Product
                    </button>
                </div>
            </div>
            <div id="productLibraryTable" class="overflow-x-auto"></div>
        </section>
    </div>
</div>

<div id="sellInventoryModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 hidden">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold text-gray-800">Sell Item</h3>
            <button onclick="closeSellInventoryModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <input type="hidden" id="sellInventoryItemId" />
        <div id="sellInventorySummary" class="bg-orange-50 rounded-lg p-4 mb-4"></div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Quantity Sold</label>
            <input type="number" id="sellQuantity" min="1" step="1" value="1"
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
        </div>

        <div id="sellInventoryPreview" class="text-sm text-gray-600 mt-4"></div>

        <button onclick="sellInventoryItem()" class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors mt-6">
            Save Sale
        </button>
    </div>
</div>

<div id="productModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 hidden">
    <div class="bg-white rounded-2xl p-8 max-w-2xl w-full shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-6">
            <h3 id="productModalTitle" class="text-2xl font-bold text-gray-800">Add Product</h3>
            <button onclick="closeProductModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <input type="hidden" id="productId" />
        <input type="hidden" id="productImage" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700 mb-2">Product Name</label>
                <input type="text" id="productName" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                <input type="text" id="productCategory" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Default Price</label>
                <input type="number" id="productDefaultPrice" min="0" step="0.01" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Barcode</label>
                <input type="text" id="productBarcode" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Unit Type</label>
                <input type="text" id="productUnitType" placeholder="piece, pack, kg, bottle" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Supplier</label>
                <input type="text" id="productSupplier" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700 mb-2">Product Image</label>
                <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
                    <div id="productImagePreview" class="w-24 h-24 rounded-lg bg-gray-100 border border-gray-200 flex items-center justify-center overflow-hidden text-gray-400 text-sm">
                        No image
                    </div>
                    <div class="flex-1">
                        <input type="file" id="productImageFile" accept="image/*"
                               class="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-orange-50 file:text-orange-600 file:font-semibold hover:file:bg-orange-100" />
                        <p class="text-xs text-gray-500 mt-2">Upload a JPG, PNG, WEBP, or GIF up to 5 MB.</p>
                        <button type="button" onclick="clearProductImage()" class="text-sm text-red-500 font-semibold mt-2 hover:text-red-600">Remove image</button>
                    </div>
                </div>
            </div>
        </div>

        <button onclick="saveProduct()" class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors mt-6">
            Save Product
        </button>
    </div>
</div>

@section Scripts {
    <script>
        let products = [];
        let inventoryItems = [];
        let selectedProduct = null;
        let selectedInventorySaleItem = null;

        document.addEventListener('DOMContentLoaded', async function () {
            await refreshInventoryPage();
            document.getElementById('inventoryProductSearch').addEventListener('input', handleProductSearchInput);
            document.getElementById('inventoryFilter').addEventListener('input', renderInventoryTable);
            document.getElementById('libraryFilter').addEventListener('input', renderProductLibrary);
            document.getElementById('productImageFile').addEventListener('change', previewProductImageFile);
            document.getElementById('sellQuantity').addEventListener('input', renderSellInventoryPreview);
        });

        async function refreshInventoryPage() {
            products = await fetchJson('/api/storedproducts');
            inventoryItems = await fetchJson('/api/inventory');
            renderProductLibrary();
            renderInventoryTable();
        }

        function focusProductSearch() {
            document.getElementById('inventoryProductSearch').focus();
        }

        function handleProductSearchInput(event) {
            const value = event.target.value.trim().toLowerCase();
            selectedProduct = null;
            renderSelectedProduct();

            if (!value) {
                document.getElementById('productSuggestions').classList.add('hidden');
                document.getElementById('productNotFound').classList.add('hidden');
                return;
            }

            const matches = products
                .filter(product =>
                    product.productName.toLowerCase().includes(value) ||
                    (product.barcode && product.barcode.toLowerCase().includes(value)))
                .slice(0, 8);

            renderSuggestions(matches, value);
        }

        function renderSuggestions(matches) {
            const suggestions = document.getElementById('productSuggestions');
            const notFound = document.getElementById('productNotFound');

            if (matches.length === 0) {
                suggestions.classList.add('hidden');
                notFound.classList.remove('hidden');
                return;
            }

            notFound.classList.add('hidden');
            suggestions.innerHTML = matches.map(product => `
                <button type="button" onclick="selectProduct(${product.id})" class="w-full text-left px-4 py-3 hover:bg-orange-50 flex gap-3 items-center border-b border-gray-100 last:border-b-0">
                    ${product.productImage ? `<img src="${escapeHtml(product.productImage)}" class="w-10 h-10 rounded object-cover" alt="">` : '<div class="w-10 h-10 rounded bg-orange-100 flex items-center justify-center text-orange-600 font-bold">P</div>'}
                    <span class="flex-1">
                        <span class="block font-semibold text-gray-800">${escapeHtml(product.productName)}</span>
                        <span class="block text-sm text-gray-500">${escapeHtml(product.category)} · ${escapeHtml(product.unitType)} · ${formatMoney(product.defaultPrice)}</span>
                    </span>
                </button>
            `).join('');
            suggestions.classList.remove('hidden');
        }

        function selectProduct(productId) {
            selectedProduct = products.find(product => product.id === productId) || null;
            document.getElementById('productSuggestions').classList.add('hidden');
            document.getElementById('productNotFound').classList.add('hidden');
            document.getElementById('inventoryProductSearch').value = selectedProduct ? selectedProduct.productName : '';
            document.getElementById('inventoryPrice').value = selectedProduct ? selectedProduct.defaultPrice : '';
            renderSelectedProduct();
        }

        function renderSelectedProduct() {
            const card = document.getElementById('selectedProductCard');
            if (!selectedProduct) {
                card.classList.add('hidden');
                card.innerHTML = '';
                return;
            }

            card.innerHTML = `
                <div class="flex gap-3 items-center">
                    ${selectedProduct.productImage ? `<img src="${escapeHtml(selectedProduct.productImage)}" class="w-14 h-14 rounded object-cover" alt="">` : '<div class="w-14 h-14 rounded bg-white flex items-center justify-center text-orange-600 font-bold">P</div>'}
                    <div>
                        <p class="font-bold text-gray-800">${escapeHtml(selectedProduct.productName)}</p>
                        <p class="text-sm text-gray-600">${escapeHtml(selectedProduct.category)} · ${escapeHtml(selectedProduct.unitType)}</p>
                        <p class="text-sm text-gray-600">Default: ${formatMoney(selectedProduct.defaultPrice)}</p>
                    </div>
                </div>
            `;
            card.classList.remove('hidden');
        }

        async function addInventoryItem() {
            const quantity = parseInt(document.getElementById('inventoryQuantity').value, 10);
            const costPrice = parseFloat(document.getElementById('inventoryCostPrice').value || '0');
            const price = parseFloat(document.getElementById('inventoryPrice').value);
            const expirationDate = document.getElementById('inventoryExpiration').value || null;

            if (!selectedProduct) {
                alert('Please select a product from the Product Master List.');
                return;
            }

            if (!Number.isInteger(quantity) || quantity <= 0) {
                alert('Quantity must be greater than 0.');
                return;
            }

            if (!Number.isFinite(price) || price < 0) {
                alert('Price must not be negative.');
                return;
            }

            if (!Number.isFinite(costPrice) || costPrice < 0) {
                alert('Cost price must not be negative.');
                return;
            }

            await fetchJson('/api/inventory', {
                method: 'POST',
                body: JSON.stringify({
                    productId: selectedProduct.id,
                    quantity,
                    costPrice,
                    price,
                    expirationDate
                })
            });

            selectedProduct = null;
            document.getElementById('inventoryProductSearch').value = '';
            document.getElementById('inventoryQuantity').value = '';
            document.getElementById('inventoryCostPrice').value = '';
            document.getElementById('inventoryPrice').value = '';
            document.getElementById('inventoryExpiration').value = '';
            renderSelectedProduct();
            await refreshInventoryPage();
            showNotification('Inventory item saved.', 'success');
        }

        function openSellInventoryModal(inventoryItemId) {
            selectedInventorySaleItem = inventoryItems.find(item => item.id === inventoryItemId) || null;
            if (!selectedInventorySaleItem) {
                alert('Inventory item not found.');
                return;
            }

            document.getElementById('sellInventoryItemId').value = selectedInventorySaleItem.id;
            document.getElementById('sellQuantity').value = '1';
            document.getElementById('sellInventorySummary').innerHTML = `
                <p class="font-bold text-gray-800">${escapeHtml(selectedInventorySaleItem.productName)}</p>
                <p class="text-sm text-gray-600">Available: ${selectedInventorySaleItem.quantity}</p>
                <p class="text-sm text-gray-600">Selling: ${formatMoney(selectedInventorySaleItem.price)} · Cost: ${formatMoney(selectedInventorySaleItem.costPrice || 0)}</p>
            `;
            renderSellInventoryPreview();
            document.getElementById('sellInventoryModal').classList.remove('hidden');
            document.getElementById('sellQuantity').focus();
        }

        function closeSellInventoryModal() {
            document.getElementById('sellInventoryModal').classList.add('hidden');
            selectedInventorySaleItem = null;
        }

        function renderSellInventoryPreview() {
            const preview = document.getElementById('sellInventoryPreview');
            if (!selectedInventorySaleItem) {
                preview.innerHTML = '';
                return;
            }

            const quantity = parseInt(document.getElementById('sellQuantity').value, 10) || 0;
            const total = quantity * Number(selectedInventorySaleItem.price || 0);
            const profit = Math.max(0, quantity * (Number(selectedInventorySaleItem.price || 0) - Number(selectedInventorySaleItem.costPrice || 0)));

            preview.innerHTML = `
                <div class="flex justify-between"><span>Total sale</span><span class="font-semibold">${formatMoney(total)}</span></div>
                <div class="flex justify-between"><span>Estimated profit</span><span class="font-semibold text-green-600">${formatMoney(profit)}</span></div>
            `;
        }

        async function sellInventoryItem() {
            if (!selectedInventorySaleItem) return;

            const quantitySold = parseInt(document.getElementById('sellQuantity').value, 10);
            if (!Number.isInteger(quantitySold) || quantitySold <= 0) {
                alert('Quantity sold must be greater than 0.');
                return;
            }

            if (quantitySold > selectedInventorySaleItem.quantity) {
                alert(`Not enough stock. Available: ${selectedInventorySaleItem.quantity}.`);
                return;
            }

            try {
                await fetchJson(`/api/inventory/${selectedInventorySaleItem.id}/sell`, {
                    method: 'POST',
                    body: JSON.stringify({ quantitySold })
                });

                closeSellInventoryModal();
                await refreshInventoryPage();
                if (typeof updateDashboard === 'function') updateDashboard();
                if (typeof updateSalesTracker === 'function') updateSalesTracker();
                showNotification('Sale recorded and stock updated.', 'success');
            } catch (error) {
                alert(error.message || 'Unable to sell inventory item.');
            }
        }

        function openProductModal(productId = null) {
            const product = productId ? products.find(item => item.id === productId) : null;
            document.getElementById('productModalTitle').textContent = product ? 'Edit Product' : 'Add Product';
            document.getElementById('productId').value = product ? product.id : '';
            document.getElementById('productName').value = product ? product.productName : '';
            document.getElementById('productCategory').value = product ? product.category : '';
            document.getElementById('productDefaultPrice').value = product ? product.defaultPrice : '';
            document.getElementById('productBarcode').value = product ? product.barcode || '' : '';
            document.getElementById('productUnitType').value = product ? product.unitType : '';
            document.getElementById('productSupplier').value = product ? product.supplier || '' : '';
            document.getElementById('productImage').value = product ? product.productImage || '' : '';
            document.getElementById('productImageFile').value = '';
            renderProductImagePreview(product ? product.productImage : '');
            document.getElementById('productModal').classList.remove('hidden');
            document.getElementById('productName').focus();
        }

        function openProductModalFromSearch() {
            openProductModal();
            document.getElementById('productName').value = document.getElementById('inventoryProductSearch').value.trim();
        }

        function closeProductModal() {
            document.getElementById('productModal').classList.add('hidden');
        }

        function previewProductImageFile(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) {
                renderProductImagePreview(document.getElementById('productImage').value);
                return;
            }

            if (!file.type.startsWith('image/')) {
                alert('Please choose an image file.');
                event.target.value = '';
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert('Product image must be 5 MB or smaller.');
                event.target.value = '';
                return;
            }

            const previewUrl = URL.createObjectURL(file);
            renderProductImagePreview(previewUrl);
        }

        function renderProductImagePreview(imageUrl) {
            const preview = document.getElementById('productImagePreview');
            if (!imageUrl) {
                preview.innerHTML = 'No image';
                return;
            }

            preview.innerHTML = `<img src="${escapeHtml(imageUrl)}" class="w-full h-full object-cover" alt="">`;
        }

        function clearProductImage() {
            document.getElementById('productImage').value = '';
            document.getElementById('productImageFile').value = '';
            renderProductImagePreview('');
        }

        async function uploadSelectedProductImage() {
            const fileInput = document.getElementById('productImageFile');
            const file = fileInput.files && fileInput.files[0];
            if (!file) {
                return document.getElementById('productImage').value || null;
            }

            const formData = new FormData();
            formData.append('image', file);

            const response = await fetch('/api/storedproducts/image', {
                method: 'POST',
                credentials: 'same-origin',
                body: formData
            });

            const data = await response.json();
            if (!response.ok) {
                throw new Error(data.message || 'Unable to upload product image.');
            }

            return data.imageUrl;
        }

        async function saveProduct() {
            const productId = document.getElementById('productId').value;
            const payload = {
                productName: document.getElementById('productName').value.trim(),
                category: document.getElementById('productCategory').value.trim(),
                defaultPrice: parseFloat(document.getElementById('productDefaultPrice').value || '0'),
                barcode: document.getElementById('productBarcode').value.trim() || null,
                unitType: document.getElementById('productUnitType').value.trim(),
                supplier: document.getElementById('productSupplier').value.trim() || null,
                productImage: null
            };

            if (!payload.productName) {
                alert('Product name should not be empty.');
                return;
            }

            if (!payload.category || !payload.unitType) {
                alert('Category and unit type are required.');
                return;
            }

            if (!Number.isFinite(payload.defaultPrice) || payload.defaultPrice < 0) {
                alert('Default price must not be negative.');
                return;
            }

            try {
                payload.productImage = await uploadSelectedProductImage();
            } catch (error) {
                alert(error.message || 'Unable to upload product image.');
                return;
            }

            try {
                const savedProduct = await fetchJson(productId ? `/api/storedproducts/${productId}` : '/api/storedproducts', {
                    method: productId ? 'PUT' : 'POST',
                    body: JSON.stringify(payload)
                });

                closeProductModal();
                await refreshInventoryPage();
                selectProduct(savedProduct.id);
                showNotification('Product saved.', 'success');
            } catch (error) {
                alert(error.message || 'Unable to save product.');
            }
        }

        async function deleteProduct(productId) {
            const product = products.find(item => item.id === productId);
            if (!product || !confirm(`Archive "${product.productName}" from the Product Master List? Existing inventory records will stay intact.`)) {
                return;
            }

            await fetchJson(`/api/storedproducts/${productId}`, { method: 'DELETE' });
            if (selectedProduct && selectedProduct.id === productId) {
                selectedProduct = null;
                renderSelectedProduct();
            }
            await refreshInventoryPage();
            showNotification('Product archived.', 'success');
        }

        function renderProductLibrary() {
            const filter = (document.getElementById('libraryFilter')?.value || '').trim().toLowerCase();
            const filtered = products.filter(product =>
                product.productName.toLowerCase().includes(filter) ||
                product.category.toLowerCase().includes(filter) ||
                (product.barcode && product.barcode.toLowerCase().includes(filter)));

            const container = document.getElementById('productLibraryTable');
            if (filtered.length === 0) {
                container.innerHTML = '<p class="text-gray-400 text-center py-10">No products in the library yet</p>';
                return;
            }

            container.innerHTML = `
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="text-left py-3 px-4 text-gray-600 font-semibold">Product</th>
                            <th class="text-left py-3 px-4 text-gray-600 font-semibold">Category</th>
                            <th class="text-left py-3 px-4 text-gray-600 font-semibold">Barcode</th>
                            <th class="text-right py-3 px-4 text-gray-600 font-semibold">Default Price</th>
                            <th class="text-center py-3 px-4 text-gray-600 font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${filtered.map(product => `
                            <tr class="border-b border-gray-100">
                                <td class="py-4 px-4">
                                    <div class="flex gap-3 items-center">
                                        ${product.productImage ? `<img src="${escapeHtml(product.productImage)}" class="w-10 h-10 rounded object-cover" alt="">` : '<div class="w-10 h-10 rounded bg-orange-100 flex items-center justify-center text-orange-600 font-bold">P</div>'}
                                        <div>
                                            <p class="font-semibold text-gray-800">${escapeHtml(product.productName)}</p>
                                            <p class="text-sm text-gray-500">${escapeHtml(product.unitType)}${product.supplier ? ` · ${escapeHtml(product.supplier)}` : ''}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4 text-gray-700">${escapeHtml(product.category)}</td>
                                <td class="py-4 px-4 text-gray-500">${escapeHtml(product.barcode || '-')}</td>
                                <td class="py-4 px-4 text-right font-semibold">${formatMoney(product.defaultPrice)}</td>
                                <td class="py-4 px-4">
                                    <div class="flex gap-2 justify-center">
                                        <button onclick="openProductModal(${product.id})" class="bg-blue-500 text-white px-3 py-1 rounded-lg text-sm font-semibold hover:bg-blue-600">Edit</button>
                                        <button onclick="deleteProduct(${product.id})" class="bg-red-500 text-white px-3 py-1 rounded-lg text-sm font-semibold hover:bg-red-600">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        }

        function renderInventoryTable() {
            const filter = (document.getElementById('inventoryFilter')?.value || '').trim().toLowerCase();
            const filtered = inventoryItems.filter(item => item.productName.toLowerCase().includes(filter));
            const container = document.getElementById('inventoryTable');

            if (filtered.length === 0) {
                container.innerHTML = '<p class="text-gray-400 text-center py-10">No inventory items recorded yet</p>';
                return;
            }

            container.innerHTML = `
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="text-left py-3 px-4 text-gray-600 font-semibold">Product ID</th>
                            <th class="text-left py-3 px-4 text-gray-600 font-semibold">Product Name</th>
                            <th class="text-right py-3 px-4 text-gray-600 font-semibold">Quantity</th>
                            <th class="text-right py-3 px-4 text-gray-600 font-semibold">Cost</th>
                            <th class="text-right py-3 px-4 text-gray-600 font-semibold">Price</th>
                            <th class="text-left py-3 px-4 text-gray-600 font-semibold">Expiration</th>
                            <th class="text-left py-3 px-4 text-gray-600 font-semibold">Date Added</th>
                            <th class="text-center py-3 px-4 text-gray-600 font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${filtered.map(item => `
                            <tr class="border-b border-gray-100">
                                <td class="py-4 px-4 text-gray-500">#${item.productId}</td>
                                <td class="py-4 px-4 font-semibold text-gray-800">${escapeHtml(item.productName)}</td>
                                <td class="py-4 px-4 text-right">
                                    <span class="${item.quantity <= 0 ? 'text-red-600 font-semibold' : ''}">${item.quantity}</span>
                                </td>
                                <td class="py-4 px-4 text-right">${formatMoney(item.costPrice || 0)}</td>
                                <td class="py-4 px-4 text-right font-semibold">${formatMoney(item.price)}</td>
                                <td class="py-4 px-4 text-gray-600">${item.expirationDate ? formatDate(item.expirationDate) : '-'}</td>
                                <td class="py-4 px-4 text-gray-600">${formatDate(item.dateAdded)}</td>
                                <td class="py-4 px-4 text-center">
                                    <button onclick="openSellInventoryModal(${item.id})"
                                            class="bg-green-500 text-white px-3 py-1 rounded-lg text-sm font-semibold hover:bg-green-600 disabled:bg-gray-300"
                                            ${item.quantity <= 0 ? 'disabled' : ''}>
                                        Sell
                                    </button>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        }

        function formatMoney(value) {
            return `PHP ${Number(value || 0).toFixed(2)}`;
        }

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>
}
