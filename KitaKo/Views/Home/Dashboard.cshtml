@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-orange-50">

    <!-- Sidebar Navigation -->
    <div class="w-20 bg-gradient-to-b from-orange-500 to-orange-600 h-screen fixed left-0 top-0 flex flex-col items-center py-6 shadow-xl z-50">
        <div class="mb-8">
            <h2 class="text-white text-2xl font-bold">K</h2>
        </div>

        <button onclick="openSaleModal()"
                class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-orange-500 hover:scale-110 transition-transform mb-6 shadow-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
        </button>

        <a href="@Url.Action("Dashboard", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 bg-white text-orange-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
        </a>

        <a href="@Url.Action("SalesTracker", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
        </a>

        <a href="@Url.Action("Inventory", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
        </a>

        <a href="@Url.Action("UtangLogs", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
        </a>

        <a href="@Url.Action("Expenses", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
            </svg>
        </a>

        <div class="mt-auto">
            <a href="@Url.Action("Profile", "Home")" class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-white hover:bg-white/30 transition-all">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="ml-20 p-8">
        <div class="bg-gradient-to-r from-orange-400 to-pink-400 rounded-2xl p-6 mb-8 shadow-lg">
            <h1 class="text-3xl font-bold text-white">KitaKo</h1>
            <p class="text-white/90 mt-2">Kamusta!</p>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-xl p-6 shadow-md">
                <p class="text-gray-500 text-sm mb-2">No. of Sales</p>
                <p class="text-3xl font-bold text-gray-800" id="totalSalesCount">0</p>
            </div>

            <div class="bg-white rounded-xl p-6 shadow-md">
                <p class="text-gray-500 text-sm mb-2">Total Sales</p>
                <p class="text-3xl font-bold text-gray-800" id="totalSalesAmount">₱0.00</p>
            </div>

            <div class="bg-white rounded-xl p-6 shadow-md">
                <p class="text-gray-500 text-sm mb-2">Profit</p>
                <p class="text-3xl font-bold text-green-500" id="totalProfit">₱0.00</p>
            </div>

            <div class="bg-white rounded-xl p-6 shadow-md">
                <p class="text-gray-500 text-sm mb-2">Loss</p>
                <p class="text-3xl font-bold text-red-500" id="totalLoss">₱0.00</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Daily Sales Goal -->
            <div class="bg-white rounded-xl p-6 shadow-md">
                <div class="flex items-start justify-between mb-4">
                    <h3 class="text-xl font-bold">Daily Sales Goal</h3>
                    <button onclick="openGoalModal()" class="text-sm text-orange-500 font-semibold hover:text-orange-600">
                        Edit
                    </button>
                </div>
                <div class="flex items-center justify-center">
                    <div class="relative w-48 h-48">
                        <svg class="transform -rotate-90 w-48 h-48">
                            <circle cx="96" cy="96" r="88" stroke="#FED7D7" stroke-width="16" fill="none" />
                            <circle id="progressCircle" cx="96" cy="96" r="88" stroke="#F97316" stroke-width="16" fill="none"
                                    stroke-dasharray="552.92" stroke-dashoffset="552.92" stroke-linecap="round" />
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                            <span class="text-3xl font-bold text-gray-800" id="progressPercent">0%</span>
                            <span class="text-sm text-gray-500" id="progressText">₱0 / ₱1000</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Utang Logs -->
            <div class="bg-white rounded-xl p-6 shadow-md">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-xl font-bold">Utang Logs</h3>
                    <button onclick="openUtangModal()" class="text-orange-500 text-sm font-semibold hover:text-orange-600">
                        + Add
                    </button>
                </div>

                <div id="upcomingUtangs">
                    <p class="text-gray-400 text-center py-8">No upcoming utangs</p>
                </div>
            </div>
        </div>

        <!-- Recent Sales -->
        <div class="mt-8 bg-white rounded-xl p-6 shadow-md" id="recentSalesContainer">
            <h3 class="text-xl font-bold mb-4">Recent Sales</h3>
            <div id="recentSalesList" class="space-y-3"></div>
        </div>
    </div>
</div>

<!-- Sale Modal -->
<div id="saleModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 hidden">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-2xl font-bold text-gray-800">Add Sale</h3>
            <button onclick="closeSaleModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Search -->
        <input type="text" id="productSearch" placeholder="Search product..."
               oninput="filterSaleProducts()"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg mb-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent text-sm" />

        <!-- Product Grid -->
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Choose a product</p>
        <div id="saleProductGrid"
             class="grid grid-cols-3 gap-2 max-h-48 overflow-y-auto mb-4 pr-1">
            <p class="col-span-3 text-center text-gray-400 text-sm py-4">Loading products...</p>
        </div>

        <!-- Qty + selected name -->
        <div class="flex items-center gap-3 mb-4 bg-gray-50 rounded-lg px-4 py-2">
            <span id="saleSelectedName" class="text-sm text-gray-400 flex-1">No product selected</span>
            <button onclick="changeSaleQty(-1)"
                    class="w-8 h-8 rounded-lg border border-gray-300 bg-white text-gray-700 text-lg font-bold hover:bg-gray-100">−</button>
            <span id="saleQtyDisplay" class="text-lg font-bold w-6 text-center text-gray-800">1</span>
            <button onclick="changeSaleQty(1)"
                    class="w-8 h-8 rounded-lg border border-gray-300 bg-white text-gray-700 text-lg font-bold hover:bg-gray-100">+</button>
        </div>

        <hr class="mb-4" />

        <!-- Totals -->
        <div class="flex justify-between text-sm text-gray-600 mb-1">
            <span>Sale amount</span>
            <strong id="saleAmountDisplay" class="text-gray-800">₱0.00</strong>
        </div>
        <div class="flex justify-between text-sm text-green-600 mb-4">
            <span>Profit</span>
            <strong id="saleProfitDisplay">₱0.00</strong>
        </div>

        <!-- Hidden inputs still used by existing addSale() -->
        <input type="hidden" id="saleAmount" />
        <input type="hidden" id="saleProfit" />
        <input type="hidden" id="saleProductId" />
        <input type="hidden" id="saleQty" />
        <input type="hidden" id="saleDescription" />

        <div id="saleCostPriceWarning" class="bg-yellow-50 border-l-4 border-yellow-400 text-yellow-700 p-3 mb-4 rounded hidden">
            <p class="font-semibold text-sm">⚠ Cost Price Not Set</p>
            <p class="text-xs mt-1">Edit the product in Inventory to set a cost price for accurate profit tracking.</p>
        </div>

        <button onclick="addSale()" id="addSaleBtn" disabled
                class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
            Add Sale
        </button>
    </div>
</div>

<!-- Utang Modal -->
<div id="utangModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 hidden">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold text-gray-800">Add Utang</h3>
            <button onclick="closeUtangModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Customer Name</label>
                <input type="text" id="utangCustomerName" placeholder="Juan Dela Cruz"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Amount (₱)</label>
                <input type="number" id="utangAmount" step="0.01" placeholder="0.00"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Potential Profit (₱) <span class="text-gray-400 text-sm">(optional)</span></label>
                <input type="number" id="utangProfit" step="0.01" placeholder="0.00"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Due Date</label>
                <input type="date" id="utangDueDate"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <button onclick="addUtang()"
                    class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors">
                Add Utang
            </button>
        </div>
    </div>
</div>

<!-- Goal Modal -->
<div id="goalModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-gray-800">Edit Daily Goal</h3>
            <button onclick="closeGoalModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Goal Amount (₱)</label>
                <input type="number" id="dailyGoalInput" step="0.01" min="0" placeholder="1000"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>

            <div class="flex gap-3">
                <button onclick="saveDailyGoal()" class="flex-1 bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors">
                    Save
                </button>
                <button onclick="closeGoalModal()" class="flex-1 bg-gray-100 text-gray-700 py-3 rounded-lg font-semibold hover:bg-gray-200 transition-colors">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    
    <script>
        
        // ── Quick-Sale Modal ──────────────────────────────────────
        let _saleProducts = [];
        let _saleSelected = null;
        let _saleQty = 1;

        async function loadSaleProducts() {
            try {
                const res = await fetch('/api/storedproducts');
                _saleProducts = await res.json();
                renderSaleGrid(_saleProducts);
            } catch {
                document.getElementById('saleProductGrid').innerHTML =
                    '<p class="col-span-3 text-center text-red-400 text-sm py-4">Failed to load products</p>';
            }
        }

        function filterSaleProducts() {
            const q = document.getElementById('productSearch').value.toLowerCase();
            renderSaleGrid(_saleProducts.filter(p => p.productName.toLowerCase().includes(q)));
        }

        function renderSaleGrid(products) {
            const grid = document.getElementById('saleProductGrid');
            if (!products.length) {
                grid.innerHTML = '<p class="col-span-3 text-center text-gray-400 text-sm py-4">No products found</p>';
                return;
            }
            grid.innerHTML = products.map(p => {
                const isSelected = _saleSelected?.id === p.id;
                const imgHtml = p.productImage
                    ? `<img src="${p.productImage}" alt="${p.productName}" class="w-12 h-12 object-cover rounded-lg mx-auto mb-1" />`
                    : `<div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center mx-auto mb-1">
                        <span class="text-orange-500 font-bold text-lg">${p.productName.charAt(0).toUpperCase()}</span>
                    </div>`;
                return `
                    <button onclick="selectSaleProduct(${p.id})"
                            class="sale-product-btn rounded-xl border p-2 text-center cursor-pointer transition-all
                                ${isSelected ? 'border-orange-500 bg-orange-50' : 'border-gray-200 bg-white hover:border-orange-300'}"
                            style="min-height:80px">
                        ${imgHtml}
                        <div class="text-xs font-semibold text-gray-800 leading-tight mb-1 truncate">${p.productName}</div>
                        <div class="text-xs font-bold text-orange-500">₱${Number(p.defaultPrice).toFixed(2)}</div>
                    </button>`;
            }).join('');
        }

        function selectSaleProduct(id) {
            _saleSelected = _saleProducts.find(p => p.id === id);
            _saleQty = 1;
            document.getElementById('saleQtyDisplay').textContent = 1;
            document.getElementById('saleSelectedName').textContent = _saleSelected.productName;
            document.getElementById('saleSelectedName').classList.remove('text-gray-400');
            document.getElementById('saleSelectedName').classList.add('text-gray-800');
            updateSaleTotals();
            renderSaleGrid(document.getElementById('productSearch').value
                ? _saleProducts.filter(p => p.productName.toLowerCase().includes(document.getElementById('productSearch').value.toLowerCase()))
                : _saleProducts);
        }

        function changeSaleQty(delta) {
            if (!_saleSelected) return;
            _saleQty = Math.max(1, _saleQty + delta);
            document.getElementById('saleQtyDisplay').textContent = _saleQty;
            updateSaleTotals();
        }

        function updateSaleTotals() {
            const saleAmt = _saleSelected.defaultPrice * _saleQty;
            const costPrice = _saleSelected.costPrice ?? 0;
            const profit = (_saleSelected.defaultPrice - costPrice) * _saleQty;

            // Warn if cost price is not set
            const warningEl = document.getElementById('saleCostPriceWarning');
            if (warningEl) {
                if (costPrice <= 0) {
                    warningEl.classList.remove('hidden');
                } else {
                    warningEl.classList.add('hidden');
                }
            }

            document.getElementById('saleAmountDisplay').textContent = '₱' + saleAmt.toFixed(2);
            document.getElementById('saleProfitDisplay').textContent = '₱' + profit.toFixed(2);

            document.getElementById('saleAmount').value = saleAmt.toFixed(2);
            document.getElementById('saleProfit').value = profit.toFixed(2);
            document.getElementById('saleProductId').value = _saleSelected.id;
            document.getElementById('saleQty').value = _saleQty;
            document.getElementById('saleDescription').value = `${_saleSelected.productName} x${_saleQty}`;

            document.getElementById('addSaleBtn').disabled = false;
        }

        // Override openSaleModal to also load products & reset state
        const _origOpenSaleModal = typeof openSaleModal === 'function' ? openSaleModal : null;
        function openSaleModal() {
            // reset state
            _saleSelected = null;
            _saleQty = 1;
            document.getElementById('productSearch').value = '';
            document.getElementById('saleQtyDisplay').textContent = 1;
            document.getElementById('saleSelectedName').textContent = 'No product selected';
            document.getElementById('saleSelectedName').className = 'text-sm text-gray-400 flex-1';
            document.getElementById('saleAmountDisplay').textContent = '₱0.00';
            document.getElementById('saleProfitDisplay').textContent = '₱0.00';
            document.getElementById('saleAmount').value = '';
            document.getElementById('saleProfit').value = '';
            document.getElementById('saleDescription').value = '';
            document.getElementById('addSaleBtn').disabled = true;

            // show modal
            document.getElementById('saleModal').classList.remove('hidden');

            // load products fresh
            loadSaleProducts();
        }

        document.addEventListener('DOMContentLoaded', function() {
            updateDashboard();
        });
    </script>
}
