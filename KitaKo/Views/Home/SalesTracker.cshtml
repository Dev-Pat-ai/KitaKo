@{
    ViewData["Title"] = "Sales & Budget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-orange-50">
    <!-- Sidebar Navigation (Same as Dashboard) -->
    <div class="w-20 bg-gradient-to-b from-orange-500 to-orange-600 h-screen fixed left-0 top-0 flex flex-col items-center py-6 shadow-xl z-50">
        <div class="mb-8">
            <h2 class="text-white text-2xl font-bold">K</h2>
        </div>

        <button onclick="openSaleModal()"
                class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-orange-500 hover:scale-110 transition-transform mb-6 shadow-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
        </button>

        <a href="@Url.Action("Dashboard", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
        </a>

        <a href="@Url.Action("SalesTracker", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 bg-white text-orange-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
        </a>

        <a href="@Url.Action("Inventory", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
        </a>

        <a href="@Url.Action("UtangLogs", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
        </a>

        <a href="@Url.Action("Expenses", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path>
            </svg>
        </a>

        <div class="mt-auto">
            <a href="@Url.Action("Profile", "Home")" class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-white hover:bg-white/30 transition-all">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="ml-20 p-8">
        <h1 class="text-4xl font-bold text-gray-800 mb-8">Sales & Budget</h1>

        <!-- Period Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl p-6 shadow-lg text-white">
                <h3 class="text-lg font-semibold mb-4">Daily</h3>
                <p class="text-3xl font-bold mb-2" id="dailySales">₱0.00</p>
                <p class="text-blue-100" id="dailyProfit">Profit: ₱0.00</p>
                <p class="text-sm text-blue-100 mt-2" id="dailyCount">0 sales</p>
            </div>

            <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl p-6 shadow-lg text-white">
                <h3 class="text-lg font-semibold mb-4">Weekly</h3>
                <p class="text-3xl font-bold mb-2" id="weeklySales">₱0.00</p>
                <p class="text-purple-100" id="weeklyProfit">Profit: ₱0.00</p>
                <p class="text-sm text-purple-100 mt-2" id="weeklyCount">0 sales</p>
            </div>

            <div class="bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl p-6 shadow-lg text-white">
                <h3 class="text-lg font-semibold mb-4">Monthly</h3>
                <p class="text-3xl font-bold mb-2" id="monthlySales">₱0.00</p>
                <p class="text-orange-100" id="monthlyProfit">Profit: ₱0.00</p>
                <p class="text-sm text-orange-100 mt-2" id="monthlyCount">0 sales</p>
            </div>
        </div>

        <!-- Sales History Table -->
        <div class="bg-white rounded-xl p-6 shadow-md">
            <h3 class="text-xl font-bold mb-4">All Sales History</h3>

            <div id="salesHistoryTable">
                <p class="text-gray-400 text-center py-12">No sales recorded yet</p>
            </div>
        </div>
    </div>
</div>

<!-- Sale Modal -->
<div id="saleModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 hidden">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl max-h-[90vh] flex flex-col">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-2xl font-bold text-gray-800">Add Sale</h3>
            <button onclick="closeSaleModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="overflow-y-auto flex-1 pr-1">
            <!-- Search -->
            <input type="text" id="productSearch" placeholder="Search product..."
                   oninput="filterSaleProducts()"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg mb-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent text-sm" />

            <!-- Product Grid -->
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Choose a product</p>
            <div id="saleProductGrid"
                 class="grid grid-cols-3 gap-2 max-h-44 overflow-y-auto mb-3 pr-1">
                <p class="col-span-3 text-center text-gray-400 text-sm py-4">Loading products...</p>
            </div>

            <!-- Qty row for currently focused product -->
            <div class="flex items-center gap-3 mb-3 bg-gray-50 rounded-lg px-4 py-2">
                <span id="saleSelectedName" class="text-sm text-gray-400 flex-1">No product selected</span>
                <button onclick="changeSaleQty(-1)"
                        class="w-8 h-8 rounded-lg border border-gray-300 bg-white text-gray-700 text-lg font-bold hover:bg-gray-100">−</button>
                <span id="saleQtyDisplay" class="text-lg font-bold w-6 text-center text-gray-800">1</span>
                <button onclick="changeSaleQty(1)"
                        class="w-8 h-8 rounded-lg border border-gray-300 bg-white text-gray-700 text-lg font-bold hover:bg-gray-100">+</button>
                <button onclick="addToCart()"
                        class="ml-1 px-3 py-1 bg-orange-500 text-white text-xs font-bold rounded-lg hover:bg-orange-600 disabled:opacity-40"
                        id="addToCartBtn" disabled>
                    + Add
                </button>
            </div>

            <!-- Cart Items -->
            <div id="saleCartSection" class="hidden mb-3">
                <div class="flex items-center justify-between mb-1">
                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Items in this transaction</p>
                    <span id="saleCartBadge" class="text-xs bg-orange-100 text-orange-600 font-bold px-2 py-0.5 rounded-full">0</span>
                </div>
                <div id="saleCartList" class="space-y-1 max-h-32 overflow-y-auto"></div>
            </div>

            <div id="saleCostPriceWarning" class="bg-yellow-50 border-l-4 border-yellow-400 text-yellow-700 p-3 mb-3 rounded hidden">
                <p class="font-semibold text-sm">⚠ Cost Price Not Set</p>
                <p class="text-xs mt-1">One or more items has no cost price. Profit tracking may be inaccurate.</p>
            </div>

            <hr class="mb-3" />

            <!-- Totals -->
            <div class="flex justify-between text-sm text-gray-600 mb-1">
                <span>Sale amount</span>
                <strong id="saleAmountDisplay" class="text-gray-800">₱0.00</strong>
            </div>
            <div class="flex justify-between text-sm text-green-600 mb-4">
                <span>Profit</span>
                <strong id="saleProfitDisplay">₱0.00</strong>
            </div>
        </div>

        <button onclick="addSale()" id="addSaleBtn" disabled
                class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors disabled:opacity-40 disabled:cursor-not-allowed mt-2">
            Add Sale
        </button>
    </div>
</div>

@section Scripts {
    <script>
        
        // ── Multi-Product Sale Modal ──────────────────────────────
        let _saleProducts = [];
        let _saleSelected = null;
        let _saleQty = 1;
        let _saleCart = []; // [{ product, qty }]

        async function loadSaleProducts() {
            try {
                const res = await fetch('/api/inventory');
                const inventoryItems = await res.json();
                _saleProducts = inventoryItems.filter(i => i.quantity > 0);
                renderSaleGrid(_saleProducts);
            } catch {
                document.getElementById('saleProductGrid').innerHTML =
                    '<p class="col-span-3 text-center text-red-400 text-sm py-4">Failed to load products</p>';
            }
        }

        function filterSaleProducts() {
            const q = document.getElementById('productSearch').value.toLowerCase();
            renderSaleGrid(_saleProducts.filter(p => p.productName.toLowerCase().includes(q)));
        }

        function renderSaleGrid(products) {
            const grid = document.getElementById('saleProductGrid');
            if (!products.length) {
                grid.innerHTML = '<p class="col-span-3 text-center text-gray-400 text-sm py-4">No products in inventory</p>';
                return;
            }
            grid.innerHTML = products.map(p => {
                const isSelected = _saleSelected?.id === p.id;
                const inCart = _saleCart.find(c => c.product.id === p.id);
                const imgUrl = p.productImage || (p.product && p.product.productImage);
                const imgHtml = imgUrl
                    ? `<img src="${imgUrl}" alt="${p.productName}" class="w-12 h-12 object-cover rounded-lg mx-auto mb-1" />`
                    : `<div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center mx-auto mb-1">
                        <span class="text-orange-500 font-bold text-lg">${p.productName.charAt(0).toUpperCase()}</span>
                    </div>`;
                const cartBadge = inCart
                    ? `<div class="absolute top-1 right-1 w-5 h-5 bg-orange-500 rounded-full flex items-center justify-center">
                        <span class="text-white text-[9px] font-bold">${inCart.qty}</span>
                       </div>` : '';
                return `
                    <button onclick="selectSaleProduct(${p.id})"
                            class="sale-product-btn relative rounded-xl border p-2 text-center cursor-pointer transition-all
                                ${isSelected ? 'border-orange-500 bg-orange-50 ring-2 ring-orange-300' : inCart ? 'border-orange-300 bg-orange-50/50' : 'border-gray-200 bg-white hover:border-orange-300'}"
                            style="min-height:80px">
                        ${cartBadge}
                        ${imgHtml}
                        <div class="text-xs font-semibold text-gray-800 leading-tight mb-1 truncate">${p.productName}</div>
                        <div class="text-xs font-bold text-orange-500">₱${Number(p.price).toFixed(2)}</div>
                        <div class="text-xs text-gray-400">Stock: ${p.quantity}</div>
                    </button>`;
            }).join('');
        }

        function selectSaleProduct(id) {
            _saleSelected = _saleProducts.find(p => p.id === id);
            const existing = _saleCart.find(c => c.product.id === id);
            _saleQty = existing ? existing.qty : 1;
            document.getElementById('saleQtyDisplay').textContent = _saleQty;
            document.getElementById('saleSelectedName').textContent = _saleSelected.productName;
            document.getElementById('saleSelectedName').className = 'text-sm text-gray-800 flex-1 font-medium truncate';
            document.getElementById('addToCartBtn').disabled = false;
            const q = document.getElementById('productSearch').value.toLowerCase();
            renderSaleGrid(q ? _saleProducts.filter(p => p.productName.toLowerCase().includes(q)) : _saleProducts);
        }

        function changeSaleQty(delta) {
            if (!_saleSelected) return;
            _saleQty = Math.max(1, Math.min(_saleSelected.quantity, _saleQty + delta));
            document.getElementById('saleQtyDisplay').textContent = _saleQty;
        }

        function addToCart() {
            if (!_saleSelected) return;
            const existing = _saleCart.find(c => c.product.id === _saleSelected.id);
            if (existing) {
                existing.qty = _saleQty;
            } else {
                _saleCart.push({ product: _saleSelected, qty: _saleQty });
            }
            _saleSelected = null;
            _saleQty = 1;
            document.getElementById('saleQtyDisplay').textContent = 1;
            document.getElementById('saleSelectedName').textContent = 'No product selected';
            document.getElementById('saleSelectedName').className = 'text-sm text-gray-400 flex-1';
            document.getElementById('addToCartBtn').disabled = true;
            renderCartList();
            updateSaleTotals();
            const q = document.getElementById('productSearch').value.toLowerCase();
            renderSaleGrid(q ? _saleProducts.filter(p => p.productName.toLowerCase().includes(q)) : _saleProducts);
        }

        function removeFromCart(productId) {
            _saleCart = _saleCart.filter(c => c.product.id !== productId);
            if (_saleSelected?.id === productId) {
                _saleSelected = null;
                _saleQty = 1;
                document.getElementById('saleQtyDisplay').textContent = 1;
                document.getElementById('saleSelectedName').textContent = 'No product selected';
                document.getElementById('saleSelectedName').className = 'text-sm text-gray-400 flex-1';
                document.getElementById('addToCartBtn').disabled = true;
            }
            renderCartList();
            updateSaleTotals();
            const q = document.getElementById('productSearch').value.toLowerCase();
            renderSaleGrid(q ? _saleProducts.filter(p => p.productName.toLowerCase().includes(q)) : _saleProducts);
        }

        function renderCartList() {
            const section = document.getElementById('saleCartSection');
            const list = document.getElementById('saleCartList');
            const badge = document.getElementById('saleCartBadge');
            if (!_saleCart.length) {
                section.classList.add('hidden');
                return;
            }
            section.classList.remove('hidden');
            badge.textContent = _saleCart.length;
            list.innerHTML = _saleCart.map(c => `
                <div class="flex items-center justify-between bg-gray-50 rounded-lg px-3 py-1.5 text-sm">
                    <span class="text-gray-800 font-medium truncate flex-1">${c.product.productName}</span>
                    <span class="text-gray-500 mx-2">x${c.qty}</span>
                    <span class="text-orange-500 font-bold mr-2">₱${(c.product.price * c.qty).toFixed(2)}</span>
                    <button onclick="removeFromCart(${c.product.id})" class="text-gray-300 hover:text-red-400 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>`).join('');
        }

        function updateSaleTotals() {
            const totalAmt = _saleCart.reduce((s, c) => s + c.product.price * c.qty, 0);
            const totalProfit = _saleCart.reduce((s, c) => s + ((c.product.price - (c.product.costPrice ?? 0)) * c.qty), 0);
            const hasMissingCost = _saleCart.some(c => (c.product.costPrice ?? 0) <= 0);
            document.getElementById('saleCostPriceWarning').classList.toggle('hidden', !hasMissingCost || _saleCart.length === 0);
            document.getElementById('saleAmountDisplay').textContent = '₱' + totalAmt.toFixed(2);
            document.getElementById('saleProfitDisplay').textContent = '₱' + totalProfit.toFixed(2);
            document.getElementById('addSaleBtn').disabled = _saleCart.length === 0;
        }

        function openSaleModal() {
            _saleSelected = null;
            _saleQty = 1;
            _saleCart = [];
            document.getElementById('productSearch').value = '';
            document.getElementById('saleQtyDisplay').textContent = 1;
            document.getElementById('saleSelectedName').textContent = 'No product selected';
            document.getElementById('saleSelectedName').className = 'text-sm text-gray-400 flex-1';
            document.getElementById('saleAmountDisplay').textContent = '₱0.00';
            document.getElementById('saleProfitDisplay').textContent = '₱0.00';
            document.getElementById('addSaleBtn').disabled = true;
            document.getElementById('addToCartBtn').disabled = true;
            document.getElementById('saleCartSection').classList.add('hidden');
            document.getElementById('saleCostPriceWarning').classList.add('hidden');
            document.getElementById('saleModal').classList.remove('hidden');
            loadSaleProducts();
        }

        function closeSaleModal() {
            document.getElementById('saleModal').classList.add('hidden');
        }

        async function addSale() {
            if (!_saleCart.length) return;
            try {
                await Promise.all(_saleCart.map(c =>
                    fetch(`/api/inventory/${c.product.id}/sell`, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ quantitySold: c.qty })
                    })
                ));
                closeSaleModal();
                updateSalesTracker();
            } catch (e) {
                alert(e.message || 'Unable to record sale.');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            updateSalesTracker();
        });
    </script>
}
