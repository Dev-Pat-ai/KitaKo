@{
    ViewData["Title"] = "Expense Priority";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-orange-50">
    <!-- Sidebar Navigation -->
    <div class="w-20 bg-gradient-to-b from-orange-500 to-orange-600 h-screen fixed left-0 top-0 flex flex-col items-center py-6 shadow-xl z-50">
        <div class="mb-8">
            <h2 class="text-white text-2xl font-bold">K</h2>
        </div>
        <button onclick="openSaleModal()"
                class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-orange-500 hover:scale-110 transition-transform mb-6 shadow-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
        </button>
        <a href="@Url.Action("Dashboard", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
        </a>
        <a href="@Url.Action("SalesTracker", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
        </a>
        <a href="@Url.Action("UtangLogs", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-white hover:bg-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
        </a>
        <a href="@Url.Action("ExpensePriority", "Home")"
           class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 bg-white text-orange-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
        </a>
        <div class="mt-auto">
            <button class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-white hover:bg-white/30 transition-all">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="ml-20 p-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-4xl font-bold text-gray-800">Expense Priority Manager</h1>
                <p class="text-gray-500 mt-1">Knapsack-powered smart budget optimization</p>
            </div>
            <button onclick="openExpenseModal()"
                    class="bg-orange-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Add Expense
            </button>
        </div>

        <!-- OVERDUE WARNING BANNER (hidden until JS populates it) -->
        <div id="overdueWarningBanner"
             class="hidden bg-red-100 border border-red-400 text-red-800 rounded-xl px-5 py-4 mb-6 text-sm font-medium shadow-sm">
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl p-6 shadow-lg text-white">
                <h3 class="text-lg font-semibold mb-4">Pending Expenses</h3>
                <p class="text-3xl font-bold mb-2" id="pendingExpensesCount">0</p>
                <p class="text-orange-100">Items to pay</p>
            </div>
            <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-xl p-6 shadow-lg text-white">
                <h3 class="text-lg font-semibold mb-4">Total Pending</h3>
                <p class="text-3xl font-bold mb-2" id="totalPendingExpenses">₱0.00</p>
                <p class="text-red-100">Amount needed</p>
            </div>
            <div class="bg-gradient-to-br from-green-500 to-green-600 rounded-xl p-6 shadow-lg text-white">
                <h3 class="text-lg font-semibold mb-4">Total Paid</h3>
                <p class="text-3xl font-bold mb-2" id="totalPaidExpenses">₱0.00</p>
                <p class="text-green-100">Already settled</p>
            </div>
        </div>

        <!-- Budget Coverage Bar -->
        <div class="bg-white rounded-xl p-6 shadow-md mb-6">
            <div class="flex justify-between items-center mb-2">
                <h4 class="font-semibold text-gray-700">Budget Coverage</h4>
                <span id="budgetCoverageLabel" class="text-sm text-gray-500">Loading…</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-4 overflow-hidden">
                <div id="budgetCoverageBar" class="h-full rounded-full bg-green-500 transition-all duration-500" style="width:0%"></div>
            </div>
        </div>

        <!-- Knapsack Optimizer -->
        <div class="bg-white rounded-xl p-6 shadow-md mb-8">
            <h3 class="text-2xl font-bold mb-1 text-gray-800">Budget Optimizer</h3>
            <p class="text-gray-500 text-sm mb-5">
                Enter a budget and click Optimize — or drag the slider to explore scenarios in real time.
            </p>

            <!-- Budget input + button row -->
            <div class="flex gap-4 items-end mb-4">
                <div class="flex-1">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Available Budget (₱)</label>
                    <input type="number" id="availableBudget" step="0.01" placeholder="5000.00" min="0"
                           oninput="debouncedWhatIf(this.value)"
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
                </div>
                <button onclick="triggerOptimize()"
                        class="bg-gradient-to-r from-orange-500 to-pink-500 text-white px-8 py-3 rounded-lg font-semibold hover:from-orange-600 hover:to-pink-600 transition-all shadow-lg">
                    🚀 Optimize
                </button>
            </div>

            <!-- What-If Slider -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    💡 What-If Slider — drag to explore budget scenarios
                </label>
                <input type="range" id="budgetSlider" min="0" max="100000" step="100" value="0"
                       oninput="onSliderInput(this.value)"
                       class="w-full accent-orange-500 cursor-pointer" />
                <div class="flex justify-between text-xs text-gray-400 mt-1">
                    <span>₱0</span>
                    <span id="sliderLabel" class="font-semibold text-orange-600">₱0</span>
                    <span>₱100,000</span>
                </div>
            </div>

            <div class="p-4 bg-blue-50 rounded-lg text-sm text-blue-800">
                <strong>How it works:</strong> The Knapsack algorithm selects the best combination of unpaid expenses
                that fit within your budget, maximizing total priority value. Bills beat stock at equal priority;
                overdue items are automatically ranked highest.
            </div>
        </div>

        <!-- Knapsack Results (recommended + skipped panels rendered by JS) -->
        <div id="knapsackResults" class="mb-8"></div>

        <!-- Expense List -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="text-lg font-bold text-gray-800">All Expenses</h3>
                <span class="text-sm text-gray-400">Sorted: unpaid first → priority → due date</span>
            </div>
            <div id="expenseListContainer">
                <div class="p-12 text-center">
                    <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <p class="text-gray-400 text-lg">No expenses yet</p>
                    <p class="text-gray-400 text-sm mt-2">Click "Add Expense" to get started</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sale Modal -->
<div id="saleModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 hidden">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold text-gray-800">Add Sale</h3>
            <button onclick="closeSaleModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Sale Amount (₱)</label>
                <input type="number" id="saleAmount" step="0.01" placeholder="0.00"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Profit (₱)</label>
                <input type="number" id="saleProfit" step="0.01" placeholder="0.00"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Description (Optional)</label>
                <input type="text" id="saleDescription" placeholder="Item description"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>
            <button onclick="addSale()"
                    class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors">
                Add Sale
            </button>
        </div>
    </div>
</div>

<!-- Add Expense Modal -->
<div id="expenseModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 hidden">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold text-gray-800">Add Expense</h3>
            <button onclick="closeExpenseModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Expense Name</label>
                <input type="text" id="expenseName" placeholder="e.g. Electricity Bill"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>
            <!-- FIX: id matches JS (expenseCost kept for backward compat; JS reads either) -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Cost (₱)</label>
                <input type="number" id="expenseCost" step="0.01" min="0.01" placeholder="0.00"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>
            <!-- NEW: Category (replaces expenseType, now wired to the API) -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                <select id="expenseCategory"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                    <option value="bill">📄 Bill (Electricity, Water, Rent…)</option>
                    <option value="subscription">🔁 Subscription (Internet, Software…)</option>
                    <option value="stock">📦 Stock / Inventory</option>
                    <option value="other">📌 Other</option>
                </select>
                <p class="text-xs text-gray-400 mt-1">Bills are prioritized over stock at equal priority.</p>
            </div>
            <!-- Priority: original 1-5 scale -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Priority (1-5)</label>
                <select id="expensePriority"
                        onchange="updatePriorityDisplay(this.value)"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                    <option value="5">5 – Critical (pay immediately)</option>
                    <option value="4">4 – High</option>
                    <option value="3" selected>3 – Medium</option>
                    <option value="2">2 – Low</option>
                    <option value="1">1 – Very Low (can wait)</option>
                </select>
                <p class="text-xs text-gray-500 mt-1" id="priorityDisplay">★★★☆☆ (3/5)</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Due Date</label>
                <input type="date" id="expenseDueDate"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent" />
            </div>
            <button onclick="addExpense()"
                    class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors">
                Add Expense
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Expense list renderer for the ExpensePriority page ──────────────
        function renderExpensePriorityList(optimizedIds) {
            const container = document.getElementById('expenseListContainer');
            if (!container) return;

            const unpaid = expenses.filter(e => !e.paid);
            const paid   = expenses.filter(e =>  e.paid);
            const sorted = [
                ...unpaid.sort((a, b) => b.priority - a.priority || new Date(a.dueDate) - new Date(b.dueDate)),
                ...paid.sort((a, b)   => new Date(a.dueDate) - new Date(b.dueDate))
            ];

            if (sorted.length === 0) {
                container.innerHTML = `
                    <div class="p-12 text-center">
                        <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8
                                     c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11
                                     0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-gray-400 text-lg">No expenses yet</p>
                        <p class="text-gray-400 text-sm mt-2">Click "Add Expense" to get started</p>
                    </div>`;
                return;
            }

            container.innerHTML = `
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="text-left py-3 px-6 text-gray-600 font-semibold text-sm">Name</th>
                                <th class="text-right py-3 px-6 text-gray-600 font-semibold text-sm">Amount</th>
                                <th class="text-center py-3 px-6 text-gray-600 font-semibold text-sm">Category</th>
                                <th class="text-center py-3 px-6 text-gray-600 font-semibold text-sm">Due Date</th>
                                <th class="text-center py-3 px-6 text-gray-600 font-semibold text-sm">Priority</th>
                                <th class="text-center py-3 px-6 text-gray-600 font-semibold text-sm">Optimizer</th>
                                <th class="text-center py-3 px-6 text-gray-600 font-semibold text-sm">Status</th>
                                <th class="text-center py-3 px-6 text-gray-600 font-semibold text-sm">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${sorted.map(expense => {
                                const daysLeft    = Math.ceil((new Date(expense.dueDate) - new Date()) / 86400000);
                                const isRecommended = optimizedIds.includes(expense.id);
                                const urgencyClass  = daysLeft < 0 ? 'text-red-600 bg-red-100'
                                                    : daysLeft <= 3 ? 'text-orange-600 bg-orange-100'
                                                    : daysLeft <= 7 ? 'text-yellow-600 bg-yellow-100'
                                                    : 'text-green-600 bg-green-100';
                                const rowBg = expense.paid      ? 'bg-gray-50'
                                            : isRecommended     ? 'bg-blue-50'
                                            : daysLeft < 0      ? 'bg-red-50'
                                            : 'bg-yellow-50';
                                const catLabel = { bill: '📄 Bill', subscription: '🔁 Sub', stock: '📦 Stock', other: '📌 Other' }[expense.category] || '—';

                                return `
                                <tr class="${rowBg} border-b border-gray-100 hover:bg-opacity-80 transition-colors">
                                    <td class="py-4 px-6">
                                        <span class="font-semibold ${expense.paid ? 'text-gray-400 line-through' : 'text-gray-800'}">
                                            ${expense.name}
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-right font-bold text-gray-800">
                                        ₱${parseFloat(expense.amount).toFixed(2)}
                                    </td>
                                    <td class="py-4 px-6 text-center text-sm text-gray-500">${catLabel}</td>
                                    <td class="py-4 px-6 text-center">
                                        <p class="text-gray-700 text-sm">${new Date(expense.dueDate).toLocaleDateString('en-PH')}</p>
                                        ${!expense.paid ? `<span class="text-xs font-semibold ${urgencyClass} px-2 py-0.5 rounded mt-1 inline-block">
                                            ${daysLeft < 0 ? Math.abs(daysLeft) + 'd overdue' : daysLeft + 'd left'}
                                        </span>` : ''}
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <span class="text-yellow-500 text-sm">${getPriorityStars(expense.priority)}</span>
                                        <span class="block text-xs text-gray-400">${expense.priority}/5</span>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        ${!expense.paid && isRecommended
                                            ? '<span class="bg-blue-500 text-white px-3 py-1 rounded-full text-xs font-semibold">✓ Recommended</span>'
                                            : !expense.paid
                                                ? '<span class="text-gray-400 text-xs">Deferred</span>'
                                                : '<span class="text-gray-300 text-xs">—</span>'
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold ${expense.paid ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'}">
                                            ${expense.paid ? 'Paid' : 'Unpaid'}
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-center">
                                        <div class="flex gap-2 justify-center">
                                            ${!expense.paid ? `
                                            <button onclick="markExpensePaid(${expense.id})"
                                                    class="bg-green-500 text-white px-3 py-1 rounded-lg text-xs font-semibold hover:bg-green-600 transition-colors">
                                                Mark Paid
                                            </button>` : ''}
                                            <button onclick="deleteExpense(${expense.id})"
                                                    class="bg-red-500 text-white px-3 py-1 rounded-lg text-xs font-semibold hover:bg-red-600 transition-colors">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>`;
                            }).join('')}
                        </tbody>
                    </table>
                </div>`;
        }

        // ── Debounced What-If (budget input oninput) ──────────────────────────
        let _whatIfTimer = null;
        function debouncedWhatIf(val) {
            clearTimeout(_whatIfTimer);
            const n = parseFloat(val);
            if (!isFinite(n) || n <= 0) return;
            // Sync slider
            const slider = document.getElementById('budgetSlider');
            if (slider) { slider.value = Math.min(n, 100000); }
            document.getElementById('sliderLabel').textContent = '₱' + n.toFixed(2);
            _whatIfTimer = setTimeout(() => triggerOptimize(), 500);
        }

        // ── Slider input handler ───────────────────────────────────────────────
        function onSliderInput(val) {
            const n = parseFloat(val);
            document.getElementById('sliderLabel').textContent = '₱' + n.toFixed(2);
            const budgetEl = document.getElementById('availableBudget');
            if (budgetEl) budgetEl.value = n.toFixed(2);
            debouncedWhatIf(n);
        }

        // ── Trigger optimization and re-render list ───────────────────────────
        async function triggerOptimize() {
            const budgetEl = document.getElementById('availableBudget');
            const budget   = parseFloat(budgetEl ? budgetEl.value : 0) || availableBudget;

            const result   = await runKnapsackOptimization(budget);
            const ids      = result ? (result.recommendedExpenses || []).map(e => e.id) : knapsackOptimizeLocal(budget);

            if (result) renderOptimizationResult(result, budget);

            // Update stats
            const optimizedTotal = expenses.filter(e => ids.includes(e.id)).reduce((s,e) => s + e.amount, 0);
            const el = document.getElementById('optimizedCost');
            if (el) el.textContent = '₱' + optimizedTotal.toFixed(2);

            renderExpensePriorityList(ids);
        }

        // ── On page load ──────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', async function () {
            await updateExpensesPage();

            // After data loaded, sync slider max to totalPending
            const total = expenses.filter(e => !e.paid).reduce((s,e) => s + e.amount, 0);
            const slider = document.getElementById('budgetSlider');
            if (slider && total > 0) {
                slider.max   = Math.ceil(total * 1.5 / 1000) * 1000;
                slider.value = Math.min(availableBudget, slider.max);
            }
            const sliderLabel = document.getElementById('sliderLabel');
            if (sliderLabel) sliderLabel.textContent = '₱' + availableBudget.toFixed(2);

            // Render expense list with last optimization result
            const ids = lastOptimizationResult
                ? (lastOptimizationResult.recommendedExpenses || []).map(e => e.id)
                : knapsackOptimizeLocal(availableBudget);
            renderExpensePriorityList(ids);
        });
    </script>
}
